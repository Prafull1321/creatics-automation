# node_modules/
# cypress/videos/
# cypress/screenshots/
# dist/
# .env
# cypress/fixtures/videos/
# cypress/fixtures/images/
# ------------------------------
# ============================================================
# Node / Cypress Automation .gitignore
# ============================================================

# Node modules
node_modules/

# Cypress generated folders
cypress/screenshots/
cypress/videos/
cypress/downloads/
cypress/reports/
cypress/.cache/

# Fixtures - big or binary files
cypress/fixtures/**/*.mp4
cypress/fixtures/**/*.mov
cypress/fixtures/**/*.avi
cypress/fixtures/**/*.mkv
cypress/fixtures/**/*.jpg
cypress/fixtures/**/*.jpeg
cypress/fixtures/**/*.png
cypress/fixtures/**/*.gif
cypress/fixtures/**/*.pdf

# OS files
.DS_Store
Thumbs.db

# Logs
*.log

# Local environment configs
.env
.env.local

# Build output
dist/
build/